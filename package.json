{
  "name": "xxl-job-cron-gen",
  "version": "0.0.1",
  "description": "一个基于 React + TypeScript 的 Cron 表达式可视化生成器组件",
  "keywords": [
    "react",
    "cron",
    "cron-expression",
    "cron-generator",
    "typescript",
    "react18",
    "react19"
  ],
  "homepage": "https://github.com/kazura233/xxl-job-cron-gen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazura233/xxl-job-cron-gen.git"
  },
  "bugs": "https://github.com/kazura233/xxl-job-cron-gen/issues",
  "author": {
    "name": "kazura233",
    "email": "kazira233@gmail.com"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./dist/styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "build:pages": "vite build",
    "dev": "vite",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2",
    "vite": "^8.0.16"
  },
  "npmName": "xxl-job-cron-gen",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.20.0"
  }
}